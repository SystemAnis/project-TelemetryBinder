    {
        "id": "a61d03ad6dc2592c",
        "type": "function",
        "z": "232c2fccccb2d285",
        "name": "function 2",
        "func": "let frutto = msg.payload.frutto;\nlet quantita = Number(msg.payload.quantità);\nlet prezzo = Number(msg.payload.prezzo);\nlet percentualeIva = Number(msg.payload.IVA);\n\nlet valoreIva = (prezzo * percentualeIva) / 100;\nlet totale = prezzo - valoreIva;\n\nmsg.payload = `Hai acquistato ${quantita} ${frutto}/e. Prezzo base: ${prezzo}€. IVA (${percentualeIva}%): ${valoreIva.toFixed(2)}€. Totale (prezzo - IVA): ${totale.toFixed(2)}€.`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 700,
        "wires": [
            [
                "5d9a0284c38f8e5a"
            ]
        ]
    },
