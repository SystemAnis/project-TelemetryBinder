            ]
        ]
    },
    {
        "id": "ab5d3b2985de2d8c",
        "type": "ui_template",
        "z": "bd221f64448ef576",
        "group": "2b4e3405a256dc6d",
        "name": "Filtri Log",
        "order": 1,
        "width": "25",
        "height": "2",
        "format": "<!-- Contenitore principale flessibile per allineare orizzontalmente i filtri e i pulsanti -->\n<div style=\"display:flex;flex-wrap:wrap;gap:14px;align-items:center;padding:4px 8px;font-size:12px\">\n\n    <!-- Selettore data di inizio: al cambio chiama subito applica() per aggiornare la tabella -->\n    <label style=\"color:#cbd5e1\">\n        Da\n        <input type=\"date\" ng-model=\"f.start\" ng-change=\"applica()\"\n               style=\"margin-left:6px;background:#0f172a;color:#e8eef8;border:1px solid #334155;border-radius:6px;padding:4px 8px\">\n    </label>\n\n    <!-- Selettore data di fine: al cambio chiama subito applica() per aggiornare la tabella -->\n    <label style=\"color:#cbd5e1\">\n        A\n        <input type=\"date\" ng-model=\"f.end\" ng-change=\"applica()\"\n               style=\"margin-left:6px;background:#0f172a;color:#e8eef8;border:1px solid #334155;border-radius:6px;padding:4px 8px\">\n    </label>\n\n    <!-- Pulsante per ripulire le date selezionate e mostrare di nuovo tutti i log -->\n    <button type=\"button\" ng-click=\"azzera()\"\n            style=\"background:#1e293b;color:#e8eef8;border:1px solid #334155;border-radius:6px;padding:4px 10px;cursor:pointer\">\n        Azzera\n    </button>\n\n    <!-- Pulsante per scaricare il file CSV filtrato sia per data sia per dispositivi spuntati -->\n    <button type=\"button\" ng-click=\"esporta()\"\n            style=\"background:#0ea5e9;color:#fff;border:0;border-radius:6px;padding:5px 12px;cursor:pointer\">\n        Esporta CSV\n    </button>\n</div>\n\n<script>\n    (function(scope) {\n    // Costruisce dinamicamente l'indirizzo del backend Flask usando l'host corrente del browser\n    var API = 'http://' + window.location.hostname + ':5000';\n\n    // Oggetto che mantiene lo stato delle date selezionate nei due input HTML\n    scope.f = { start: '', end: '' };\n\n    // Array che memorizza gli ID dei dispositivi spuntati nel widget \"Filtri Monitoraggio\"\n    // (null indica che non è ancora arrivato alcun filtro dal nodo delle checkbox)\n    scope.selectedSensors = null;\n\n    // Rimane in ascolto dei messaggi Node-RED in ingresso su questo nodo template\n    scope.$watch('msg', function(msg) {\n        // Intercetta solo i messaggi provenienti dalle checkbox dei dispositivi\n        if (msg && msg.topic === 'tb/filter/sensors' && Array.isArray(msg.payload)) {\n            scope.selectedSensors = msg.payload;\n        }\n    });\n\n    // Converte un oggetto Date o una stringa nel formato standard ISO \"YYYY-MM-DD\"\n    function dataISO(valore) {\n        if (!valore) { return ''; }\n        if (typeof valore === 'string') { return valore.substring(0, 10); }\n        var anno = valore.getFullYear();\n        var mese = ('0' + (valore.getMonth() + 1)).slice(-2);\n        var giorno = ('0' + valore.getDate()).slice(-2);\n        return anno + '-' + mese + '-' + giorno;\n    }\n\n    // Invia al flusso Node-RED (verso tb_set_log_filter) l'intervallo di date scelto per filtrare la UI\n    scope.applica = function() {\n        scope.send({\n            topic: 'tb/filter/log',\n            payload: {\n                start: dataISO(scope.f.start),\n                end: dataISO(scope.f.end)\n            }\n        });\n    };\n\n    // Svuota entrambi i campi data e riapplica il filtro per ripristinare la vista completa\n    scope.azzera = function() {\n        scope.f.start = '';\n        scope.f.end = '';\n        scope.applica();\n    };\n\n    // Costruisce l'URL con i parametri query string (date + sensori) e avvia il download del CSV\n    scope.esporta = function() {\n        var inizio = dataISO(scope.f.start);\n        var fine = dataISO(scope.f.end);\n        var query = [];\n\n        // Aggiunge i parametri temporali solo se valorizzati dall'utente\n        if (inizio) { query.push('inizio=' + encodeURIComponent(inizio)); }\n        if (fine)   { query.push('fine=' + encodeURIComponent(fine)); }\n\n        // Aggiunge la lista dei sensori selezionati separati da virgola (es. sensor_id=s1,s2)\n        if (Array.isArray(scope.selectedSensors)) {\n            query.push('sensor_id=' + encodeURIComponent(scope.selectedSensors.join(',')));\n        }\n\n        // Reindirizza il browser all'endpoint Flask che restituisce il file CSV in allegato\n        window.location = API + '/api/telemetry/export' +\n            (query.length ? '?' + query.join('&') : '');\n    };\n\n    // Inizializza lo stato del filtro nel flusso appena il widget viene caricato\n    scope.applica();\n})(scope);\n</script>",
