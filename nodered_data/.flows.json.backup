        "type": "function",
        "z": "38cea33a51cf4774",
        "name": "Prepara Dati",
        "func": "if (msg.payload && msg.payload.meals && msg.payload.meals.length > 0) {\n    let pasto = msg.payload.meals[0];\n    \n    msg.nome_piatto = pasto.strMeal;\n    msg.istruzioni = pasto.strInstructions;\n    \n    return msg;\n}\nreturn null;",
