    {
        "id": "7914dff50d471e33",
        "type": "ui_template",
        "z": "bd221f64448ef576",
        "group": "telemetry_group",
        "name": "Filtri Monitoraggio",
        "order": 0,
        "width": "25",
        "height": "2",
        "format": "<div style=\"display:flex;flex-wrap:wrap;gap:14px;align-items:center;padding:4px 8px;font-size:12px\">\n    <span style=\"color:#94a3b8;text-transform:uppercase;letter-spacing:.08em\">Dispositivi</span>\n\n    <label ng-repeat=\"s in sensors\" style=\"display:flex;align-items:center;gap:6px;color:#e8eef8\">\n    <input type=\"checkbox\" ng-model=\"s.checked\" ng-change=\"applica()\">\n    {{s.id}}\n  </label>\n\n    <button type=\"button\" ng-click=\"tutti()\"\n          style=\"background:#1e293b;color:#e8eef8;border:1px solid #334155;border-radius:6px;padding:4px 10px;cursor:pointer\">\n    Tutti\n  </button>\n\n    <span ng-if=\"errore\" style=\"color:#ff6b6b\">{{errore}}</span>\n</div>\n\n<script>\n    (function(scope) {\n    var API = 'http://' + window.location.hostname + ':5000';\n\n    scope.sensors = [];\n    scope.errore = '';\n\n    scope.applica = function() {\n        var scelti = scope.sensors\n            .filter(function(s) { return s.checked; })\n            .map(function(s) { return s.id; });\n\n        scope.send({\n            topic: 'tb/filter/sensors',\n            payload: scelti\n        });\n    };\n\n    scope.tutti = function() {\n        scope.sensors.forEach(function(s) { s.checked = true; });\n        scope.applica();\n    };\n\n    fetch(API + '/api/sensors')\n        .then(function(r) {\n            if (!r.ok) { throw new Error('HTTP ' + r.status); }\n            return r.json();\n        })\n        .then(function(ids) {\n            scope.$apply(function() {\n                scope.sensors = ids.map(function(id) {\n                    return { id: id, checked: true };\n                });\n                scope.applica();\n            });\n        })\n        .catch(function(err) {\n            console.error(err);\n            scope.$apply(function() {\n                scope.errore = 'Backend non raggiungibile';\n            });\n        });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
