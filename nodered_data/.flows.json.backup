                "c639411c9ebd65a8"
            ]
        ]
    },
    {
        "id": "5ebb38cbf4ccfd3d",
        "type": "function",
        "z": "bd221f64448ef576",
        "name": "function 4",
        "func": "// Se il backend restituisce un errore (oggetto) invece della lista, evito il crash\nlet records = Array.isArray(msg.payload) ? msg.payload : [];\n\nconst sensorFilter = flow.get('tb_sensor_filter');\nif (Array.isArray(sensorFilter)) {\n    records = records.filter(r => sensorFilter.includes(r.sensor_id));\n}\n\n// Filtro il database per separare le tre metriche\nlet tempRecords = records.filter(r => r.metric === \"temperatura\");\nlet humRecords = records.filter(r => r.metric === \"umidita\");\nlet ramRecords = records.filter(r => r.metric === \"utilizzo_ram\");\n\n// Estraggo solo l'ultimo valore per ogni metrica\nlet lastTemp = tempRecords.length > 0 ? tempRecords[tempRecords.length - 1].value : 0;\nlet lastHum = humRecords.length > 0 ? humRecords[humRecords.length - 1].value : 0;\nlet lastRam = ramRecords.length > 0 ? ramRecords[ramRecords.length - 1].value : 0;\n\n// Filtriamo WARNING e CRITICAL, invertendo l'ordine per avere i piu' recenti in cima\nlet anomalies = records.filter(r => r.status !== \"OK\").reverse();\n\n// Filtro date: confronto la data locale italiana con gli input type=\"date\"\nconst logStart = flow.get('tb_log_start') || '';\nconst logEnd = flow.get('tb_log_end') || '';\n\nif (logStart || logEnd) {\n    anomalies = anomalies.filter(function(r) {\n        let rawTs = r.timestamp.includes('T')\n            ? r.timestamp\n            : r.timestamp.replace(' ', 'T');\n\n        if (!rawTs.endsWith('Z') && !rawTs.includes('+')) rawTs += 'Z';\n\n        const giorno = new Date(rawTs).toLocaleDateString('sv-SE', {\n            timeZone: 'Europe/Rome'\n        });\n\n        return (!logStart || giorno >= logStart) &&\n               (!logEnd || giorno <= logEnd);\n    });\n}\n\nlet tableData = anomalies.map(r => {\n    // Converte il timestamp UTC del DB nel fuso italiano (gestisce in automatico ora solare e legale)\n    let rawTs = r.timestamp.includes('T') ? r.timestamp : r.timestamp.replace(' ', 'T');\n    if (!rawTs.endsWith('Z') && !rawTs.includes('+')) rawTs += 'Z';\n\n    let oraLocale = new Date(rawTs).toLocaleTimeString('it-IT', {\n        timeZone: 'Europe/Rome',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit'\n    });\n\n    // Differenzia CRITICAL (rosso) e WARNING (giallo)\n    let statusHtml = r.status === \"CRITICAL\"\n        ? '<span style=\"color: #ff3b3b !important; font-weight: 700;\">CRITICAL</span>'\n        : '<span style=\"color: #facc15 !important; font-weight: 700;\">WARNING</span>';\n\n    return {\n        \"Time\": oraLocale,\n        \"Device\": r.sensor_id,\n        \"Metric\": r.metric,\n        \"Status\": statusHtml,\n        \"Value\": r.value\n    };\n});\n\n// Inviamo i dati sui 4 pin di uscita separati!\nreturn [\n    { payload: lastTemp }, // Gauge/Chart Temperatura\n    { payload: lastHum },  // Gauge/Chart Umidita\n    { payload: lastRam },  // Gauge/Chart RAM\n    { payload: tableData } // Tabella Allarmi\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 320,
        "wires": [
            [
                "2cbc1aa1dcee3f2f",
                "4394ad0f12d2a501"
            ],
            [
                "11f8d1024b6b15a0",
                "ee154635119a9062"
            ],
            [
                "f7d5dc91a97ef439",
                "06a9e8921d6e3795"
            ],
            [
                "c0c8d5cbaabeee61"
            ]
        ]
    },
