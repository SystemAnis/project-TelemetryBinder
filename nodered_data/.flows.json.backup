        "func": "let cognome = msg.payload.surname;\nlet nome = msg.payload.name;\nlet anni = msg.payload.age;\n\nlet frase = nome + \" \" + cognome + \" ha\" + \" \" + anni + \" anni\";\n\nmsg.payload = frase;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
