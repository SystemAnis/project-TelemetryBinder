    {
        "id": "tb_config_template",
        "type": "ui_template",
        "z": "bd221f64448ef576",
        "group": "tb_config_group",
        "name": "Configuration & Alerts",
        "order": 1,
        "width": "25",
        "height": "4",
        "format": "<form name=\"tbCfg\" class=\"tb-config-form\" novalidate ng-submit=\"tbCfg.$valid && salvaConfig()\">\n\n    <div class=\"tb-config-head\">\n        <div class=\"tb-config-sub\">\n            Definisci le soglie massime. Al superamento viene registrato un allarme.\n        </div>\n\n        <label class=\"tb-switch\">\n      <input type=\"checkbox\" ng-model=\"cfg.enabled\"\n             ng-change=\"salvaSoloAvvisi()\"\n             ng-disabled=\"cfg.loading || cfg.saving\">\n      <span class=\"tb-switch-track\" aria-hidden=\"true\"></span>\n      <span>Avvisi attivi</span>\n    </label>\n    </div>\n\n    <!-- Selettore del dispositivo di destinazione (Default globale oppure singolo sensore) -->\n    <div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:10px 0 14px 0\">\n        <label style=\"display:flex;align-items:center;gap:8px;font-size:.85rem;color:#cbd5e1\">\n      <span>Dispositivo:</span>\n      <select ng-model=\"cfg.sensorId\"\n              ng-change=\"caricaConfig()\"\n              ng-disabled=\"cfg.loading || cfg.saving\"\n              style=\"background:#0f172a;color:#e8eef8;border:1px solid #334155;border-radius:6px;padding:5px 10px;font-size:.85rem;cursor:pointer\">\n        <option value=\"default\">Default (tutti i dispositivi)</option>\n        <option ng-repeat=\"s in cfg.sensors\" ng-value=\"s\">{{s}}</option>\n      </select>\n    </label>\n\n        <!-- Badge grigio se il dispositivo eredita le regole base -->\n        <span ng-if=\"cfg.sensorId !== 'default' && cfg.isDefault\"\n          style=\"font-size:.75rem;color:#94a3b8;background:#1e293b;border:1px solid #334155;border-radius:999px;padding:2px 9px\">\n      Usa soglie Default\n    </span>\n\n        <!-- Badge azzurro + pulsante di ripristino se il dispositivo ha un'eccezione salvata -->\n        <span ng-if=\"cfg.sensorId !== 'default' && !cfg.isDefault\"\n          style=\"font-size:.75rem;color:#38bdf8;background:rgba(14,165,233,.12);border:1px solid rgba(56,189,248,.35);border-radius:999px;padding:2px 9px\">\n      Soglie personalizzate attive\n    </span>\n\n        <button type=\"button\"\n            ng-if=\"cfg.sensorId !== 'default' && !cfg.isDefault\"\n            ng-click=\"ripristinaDefault()\"\n            ng-disabled=\"cfg.loading || cfg.saving\"\n            style=\"background:#1e293b;color:#e2e8f0;border:1px solid #475569;border-radius:6px;padding:3px 9px;font-size:.75rem;cursor:pointer\">\n      Ripristina Default\n    </button>\n    </div>\n\n    <div class=\"tb-config-grid\">\n        <label class=\"tb-field\">\n      <span>Temperatura</span>\n      <span class=\"tb-input\">\n        <input type=\"number\" ng-model=\"cfg.temp\" min=\"0\" max=\"100\"\n               step=\"0.1\" required ng-change=\"cfg.saved = false\"\n               ng-disabled=\"cfg.loading || cfg.saving\">\n        <em>&deg;C</em>\n      </span>\n    </label>\n\n        <label class=\"tb-field\">\n      <span>Umidit&agrave;</span>\n      <span class=\"tb-input\">\n        <input type=\"number\" ng-model=\"cfg.hum\" min=\"0\" max=\"100\"\n               step=\"1\" required ng-change=\"cfg.saved = false\"\n               ng-disabled=\"cfg.loading || cfg.saving\">\n        <em>%</em>\n      </span>\n    </label>\n\n        <label class=\"tb-field\">\n      <span>RAM</span>\n      <span class=\"tb-input\">\n        <input type=\"number\" ng-model=\"cfg.ram\" min=\"0\" max=\"100\"\n               step=\"1\" required ng-change=\"cfg.saved = false\"\n               ng-disabled=\"cfg.loading || cfg.saving\">\n        <em>%</em>\n      </span>\n    </label>\n    </div>\n\n    <div class=\"tb-config-actions\">\n        <span class=\"tb-saved\" ng-if=\"cfg.saved\">&check; Configurazione salvata</span>\n        <span ng-if=\"cfg.loading\" style=\"font-size:.8rem;color:#94a3b8;margin-right:.75rem\">Caricamento...</span>\n        <span ng-if=\"cfg.error\" style=\"font-size:.8rem;color:#ff6b6b;margin-right:.75rem\">{{cfg.error}}</span>\n        <button type=\"button\" class=\"tb-btn\" ng-disabled=\"tbCfg.$invalid || cfg.loading || cfg.saving\"\n            ng-click=\"salvaConfig()\">\n      Salva configurazione\n    </button>\n    </div>\n</form>\n\n<script>\n    (function(scope) {\n    // Il backend Flask e' esposto sulla porta 5000 dello stesso host della dashboard.\n    var API_BASE = 'http://' + window.location.hostname + ':5000';\n\n    scope.cfg = {\n        sensorId: 'default',\n        sensors: [],\n        isDefault: true,\n        temp: 45,\n        hum: 70,\n        ram: 90,\n        enabled: true,\n        loading: true,\n        saving: false,\n        saved: false,\n        error: ''\n    };\n\n    function applicaConfig(data, forzatoPersonalizzato) {\n        scope.cfg.temp = data.tempMax;\n        scope.cfg.hum = data.umiditaMax;\n        scope.cfg.ram = data.ramMax;\n        scope.cfg.enabled = !!data.alertsEnabled;\n        if (forzatoPersonalizzato !== undefined) {\n            scope.cfg.isDefault = !forzatoPersonalizzato;\n        } else {\n            scope.cfg.isDefault = (data.is_default !== undefined)\n                ? !!data.is_default\n                : (scope.cfg.sensorId === 'default');\n        }\n        scope.cfg.loading = false;\n        scope.cfg.saving = false;\n        scope.cfg.error = '';\n    }\n\n    function gestisciErrore(err) {\n        console.error('Errore configurazione alert:', err);\n        scope.cfg.loading = false;\n        scope.cfg.saving = false;\n        scope.cfg.error = 'Backend non raggiungibile';\n    }\n\n    // Invia GET/DELETE /api/config?sensor_id=... oppure POST /api/config con sensor_id nel JSON\n    function richiestaConfig(method, corpo) {\n        var url = API_BASE + '/api/config';\n        var opzioni = { method: method, headers: {} };\n\n        if (method === 'GET' || method === 'DELETE') {\n            url += '?sensor_id=' + encodeURIComponent(scope.cfg.sensorId || 'default');\n        } else if (corpo !== undefined) {\n            var payload = Object.assign({ sensor_id: scope.cfg.sensorId || 'default' }, corpo);\n            opzioni.headers['Content-Type'] = 'application/json';\n            opzioni.body = JSON.stringify(payload);\n        }\n\n        return fetch(url, opzioni).then(function(risposta) {\n            if (!risposta.ok) {\n                throw new Error('HTTP ' + risposta.status);\n            }\n            return risposta.json();\n        });\n    }\n\n    // Popola il menu a tendina con tutti i dispositivi presenti nel database\n    scope.caricaSensori = function() {\n        fetch(API_BASE + '/api/sensors')\n            .then(function(risposta) {\n                if (!risposta.ok) { throw new Error('HTTP ' + risposta.status); }\n                return risposta.json();\n            })\n            .then(function(lista) {\n                if (Array.isArray(lista)) {\n                    scope.$apply(function() { scope.cfg.sensors = lista; });\n                }\n            })\n            .catch(function(err) {\n                console.warn('Impossibile caricare elenco sensori:', err);\n            });\n    };\n\n    scope.caricaConfig = function() {\n        scope.cfg.loading = true;\n        scope.cfg.saved = false;\n        richiestaConfig('GET').then(function(data) {\n            scope.$apply(function() { applicaConfig(data); });\n        }).catch(function(err) {\n            scope.$apply(function() { gestisciErrore(err); });\n        });\n    };\n\n    scope.salvaConfig = function() {\n        if (scope.cfg.loading || scope.cfg.saving) { return; }\n        scope.cfg.saving = true;\n        scope.cfg.saved = false;\n\n        richiestaConfig('POST', {\n            tempMax: Number(scope.cfg.temp),\n            umiditaMax: Number(scope.cfg.hum),\n            ramMax: Number(scope.cfg.ram),\n            alertsEnabled: !!scope.cfg.enabled\n        }).then(function(risposta) {\n            scope.$apply(function() {\n                var personalizzato = (scope.cfg.sensorId !== 'default');\n                applicaConfig(risposta.config || risposta, personalizzato);\n                scope.cfg.saved = true;\n            });\n        }).catch(function(err) {\n            scope.$apply(function() { gestisciErrore(err); });\n        });\n    };\n\n    // Elimina le soglie personalizzate del sensore e ricarica quelle Default\n    scope.ripristinaDefault = function() {\n        if (scope.cfg.loading || scope.cfg.saving || scope.cfg.sensorId === 'default') { return; }\n        scope.cfg.saving = true;\n        scope.cfg.saved = false;\n\n        richiestaConfig('DELETE').then(function(risposta) {\n            scope.$apply(function() {\n                applicaConfig(risposta.config || risposta, false);\n                scope.cfg.saved = true;\n            });\n        }).catch(function(err) {\n            scope.$apply(function() { gestisciErrore(err); });\n        });\n    };\n\n    // Lo switch salva subito il suo stato per il dispositivo selezionato\n    scope.salvaSoloAvvisi = function() {\n        if (scope.cfg.loading || scope.cfg.saving) { return; }\n        scope.cfg.saving = true;\n        scope.cfg.saved = false;\n\n        richiestaConfig('POST', { alertsEnabled: !!scope.cfg.enabled })\n            .then(function(risposta) {\n                scope.$apply(function() {\n                    var config = risposta.config || risposta;\n                    scope.cfg.enabled = !!config.alertsEnabled;\n                    if (scope.cfg.sensorId !== 'default') {\n                        scope.cfg.isDefault = false;\n                    }\n                    scope.cfg.saving = false;\n                    scope.cfg.saved = true;\n                    scope.cfg.error = '';\n                });\n            })\n            .catch(function(err) {\n                scope.$apply(function() {\n                    // In caso di errore ripristino lo stato precedente dello switch\n                    scope.cfg.enabled = !scope.cfg.enabled;\n                    gestisciErrore(err);\n                });\n            });\n    };\n\n    scope.caricaSensori();\n    scope.caricaConfig();\n})(scope);\n</script>",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "tb-config-card",
        "x": 920,
        "y": 620,
        "wires": [
            []
        ]
    },
    {
        "id": "tb_global_css",
        "type": "ui_template",
        "z": "bd221f64448ef576",
        "group": "",
        "name": "Global CSS - Control Room",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<style id=\"tb-control-room-css\">\n/* TelemetryBinder — Control Room only.\n   Scoped by .tb-panel (present only in Dashboard_Grafica / Control Room)\n   and by body:has(.tb-panel), so other Dashboard 1 tabs keep their theme. */\n\nbody:has(.tb-panel) {\n  background:\n    radial-gradient(1200px 720px at 16% -8%, #172a44 0%, #0b1220 40%, #070c15 100%)\n    fixed !important;\n}\n\nbody:has(.tb-panel) md-content,\nbody:has(.tb-panel) #Tab_Control_Room {\n  background: transparent !important;\n}\n\nbody:has(.tb-panel) #toolbar {\n  background: rgba(9, 15, 26, .93) !important;\n  border-bottom: 1px solid rgba(148, 163, 184, .14);\n  box-shadow: 0 10px 30px rgba(0, 0, 0, .25) !important;\n}\n\nbody:has(.tb-panel) #toolbar .md-toolbar-tools h1 {\n  color: #e6eef9 !important;\n  font-weight: 600;\n  letter-spacing: .025em;\n}\n\nbody:has(.tb-panel) #toolbar .md-toolbar-tools h1::before {\n  content: \"TelemetryBinder\";\n  color: #ffffff;\n  font-size: .78em;\n  font-weight: 700;\n  letter-spacing: .01em;\n  margin-right: 14px;\n  padding-right: 14px;\n  border-right: 1px solid rgba(148, 163, 184, .25);\n}\n\nbody:has(.tb-panel) #toolbar md-button,\nbody:has(.tb-panel) #toolbar .md-icon-button {\n  color: #cfe0f5 !important;\n}\n\n/* Cards */\n.nr-dashboard-cardpanel.tb-panel {\n  background:\n    linear-gradient(180deg, rgba(30, 42, 60, .97) 0%, rgba(21, 30, 46, .99) 100%)\n    !important;\n  border: 1px solid rgba(148, 163, 184, .16) !important;\n  border-radius: 16px !important;\n  box-shadow:\n    0 18px 50px rgba(0, 0, 0, .38),\n    inset 0 1px 0 rgba(255, 255, 255, .04) !important;\n}\n\n/* Dashboard 1 wraps every widget in an md-card painted with the theme's\n   group background. Make them transparent so the panel gradient shows. */\n.tb-panel md-card {\n  background: transparent !important;\n  box-shadow: none !important;\n}\n\n.tb-panel .nr-dashboard-cardtitle {\n  color: #e6eef9 !important;\n  text-transform: uppercase;\n  letter-spacing: .13em;\n  font-size: 12px;\n  font-weight: 600;\n  opacity: .94;\n  margin-top: 16px;\n  margin-bottom: 6px;\n  margin-left: 16px;\n}\n\n.tb-panel .nr-dashboard-cardtitle::before {\n  content: \"\";\n  display: inline-block;\n  width: 3px;\n  height: 13px;\n  border-radius: 2px;\n  background: linear-gradient(180deg, #38bdf8, #6366f1);\n  box-shadow: 0 0 10px rgba(56, 189, 248, .55);\n  margin-right: 9px;\n  vertical-align: -2px;\n}\n\n/* Gauge / chart titles */\n.tb-telemetry .nr-dashboard-gauge-title,\n.tb-telemetry .nr-dashboard-chart-title {\n  color: #9fb2cd !important;\n  text-transform: uppercase;\n  letter-spacing: .08em;\n  font-size: 11px;\n  font-weight: 600;\n  opacity: .92;\n}\n\n.tb-telemetry .nr-dashboard-gauge svg text {\n  fill: #f4f8ff !important;\n  font-family: \"Inter\", \"Segoe UI\", system-ui, sans-serif !important;\n}\n\n.tb-telemetry .nr-dashboard-gauge svg text[font-size=\"11px\"] {\n  fill: #9fb2cd !important;\n}\n\n.tb-telemetry .nr-dashboard-gauge svg path[fill=\"#7f7f7f\"] {\n  fill: #26344a !important;\n}\n\n.tb-telemetry .nr-dashboard-chart-container {\n  background: transparent !important;\n}\n\n/* Log table */\n.tb-logs .tabulator {\n  background: transparent !important;\n  border: 0 !important;\n  color: #dbe7f7 !important;\n  font-size: 13px;\n}\n\n.tb-logs .tabulator .tabulator-table,\n.tb-logs .tabulator .tabulator-tableHolder {\n  background: transparent !important;\n}\n\n.tb-logs .tabulator .tabulator-header {\n  background: transparent !important;\n  border-bottom: 1px solid rgba(148, 163, 184, .16) !important;\n  color: #8fa3bf !important;\n}\n\n.tb-logs .tabulator .tabulator-col {\n  background: transparent !important;\n  border-right: 0 !important;\n  text-transform: uppercase;\n  letter-spacing: .07em;\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.tb-logs .tabulator .tabulator-col .tabulator-col-content {\n  padding: 10px 12px;\n}\n\n.tb-logs .tabulator .tabulator-col:last-child .tabulator-col-content {\n  justify-content: flex-end;\n}\n\n.tb-logs .tabulator .tabulator-col:last-child .tabulator-col-title {\n  text-align: right;\n}\n\n.tb-logs .tabulator .tabulator-row {\n  background: transparent !important;\n  border-bottom: 1px solid rgba(148, 163, 184, .07) !important;\n  min-height: 40px;\n}\n\n.tb-logs .tabulator .tabulator-row.tabulator-row-even {\n  background: rgba(255, 255, 255, .015) !important;\n}\n\n.tb-logs .tabulator .tabulator-row:hover {\n  background: rgba(56, 189, 248, .06) !important;\n}\n\n.tb-logs .tabulator .tabulator-cell {\n  border-right: 0 !important;\n  padding: 9px 12px;\n  color: #dbe7f7 !important;\n}\n\n.tb-logs .tabulator-cell[tabulator-field=\"Status\"],\n.tb-logs .tabulator-row .tabulator-cell:nth-child(4) {\n  color: #fb7185 !important;\n  font-weight: 700;\n  letter-spacing: .04em;\n}\n\n.tb-logs .tabulator-cell[tabulator-field=\"Value\"],\n.tb-logs .tabulator-row .tabulator-cell:nth-child(5) {\n  color: #e6eef9 !important;\n  font-variant-numeric: tabular-nums;\n}\n\n.tb-logs .tabulator .tabulator-tableHolder::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n.tb-logs .tabulator .tabulator-tableHolder::-webkit-scrollbar-thumb {\n  background: #2a3a52;\n  border-radius: 999px;\n}\n.tb-logs .tabulator .tabulator-tableHolder::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n/* Configuration & Alerts */\n.tb-config-card .nr-dashboard-template {\n  height: 100%;\n}\n\n.tb-config-form {\n  --tb-text: #e6eef9;\n  --tb-muted: #8fa3bf;\n  --tb-border: rgba(148, 163, 184, .18);\n  box-sizing: border-box;\n  padding: 4px 16px 16px;\n  color: var(--tb-text);\n  font-family: \"Inter\", \"Segoe UI\", system-ui, sans-serif;\n}\n\n.tb-config-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  margin: 4px 0 14px;\n}\n\n.tb-config-sub {\n  color: var(--tb-muted);\n  font-size: 12px;\n  line-height: 1.5;\n  max-width: 640px;\n}\n\n.tb-switch {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  cursor: pointer;\n  color: #cfe0f5;\n  font-size: 12px;\n  font-weight: 600;\n  white-space: nowrap;\n  user-select: none;\n}\n\n.tb-switch input {\n  position: absolute;\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n\n.tb-switch-track {\n  width: 38px;\n  height: 21px;\n  border-radius: 999px;\n  background: #253247;\n  border: 1px solid #33445e;\n  position: relative;\n  transition: .2s ease;\n  flex: 0 0 auto;\n}\n\n.tb-switch-track::after {\n  content: \"\";\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 15px;\n  height: 15px;\n  border-radius: 50%;\n  background: #8fa3bf;\n  transition: .2s ease;\n}\n\n.tb-switch input:checked + .tb-switch-track {\n  background: linear-gradient(135deg, #2563eb, #38bdf8);\n  border-color: #38bdf8;\n  box-shadow: 0 0 14px rgba(56, 189, 248, .35);\n}\n\n.tb-switch input:checked + .tb-switch-track::after {\n  transform: translateX(17px);\n  background: #ffffff;\n}\n\n.tb-switch input:focus-visible + .tb-switch-track {\n  outline: 2px solid #93c5fd;\n  outline-offset: 2px;\n}\n\n.tb-config-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.tb-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.tb-field > span:first-child {\n  color: var(--tb-muted);\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: .08em;\n  font-weight: 600;\n}\n\n.tb-input {\n  display: flex;\n  align-items: center;\n  background: #0f1726;\n  border: 1px solid var(--tb-border);\n  border-radius: 10px;\n  padding: 0 10px;\n  transition: .18s ease;\n}\n\n.tb-input:focus-within {\n  border-color: #38bdf8;\n  box-shadow: 0 0 0 3px rgba(56, 189, 248, .12);\n}\n\n.tb-input input {\n  flex: 1;\n  min-width: 0;\n  height: 38px;\n  background: transparent;\n  border: 0;\n  outline: 0;\n  color: var(--tb-text);\n  font-size: 14px;\n  font-variant-numeric: tabular-nums;\n}\n\n.tb-input input::-webkit-outer-spin-button,\n.tb-input input::-webkit-inner-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n.tb-input input[type=\"number\"] {\n  -moz-appearance: textfield;\n}\n\n.tb-input em {\n  font-style: normal;\n  color: var(--tb-muted);\n  font-size: 12px;\n}\n\n.tb-config-actions {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 14px;\n  margin-top: 14px;\n}\n\n.tb-saved {\n  color: #2dd4bf;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.tb-btn {\n  border: 0;\n  border-radius: 9px;\n  padding: 10px 18px;\n  color: #fff;\n  font-weight: 700;\n  font-size: 12px;\n  letter-spacing: .02em;\n  cursor: pointer;\n  background: linear-gradient(135deg, #2563eb, #38bdf8);\n  box-shadow: 0 8px 22px rgba(37, 99, 235, .3);\n  transition: .18s ease;\n}\n\n.tb-btn:hover {\n  filter: brightness(1.08);\n  transform: translateY(-1px);\n}\n\n.tb-btn:disabled {\n  opacity: .45;\n  cursor: not-allowed;\n  filter: none;\n  transform: none;\n  box-shadow: none;\n}\n\n.tb-btn:focus-visible {\n  outline: 2px solid #93c5fd;\n  outline-offset: 2px;\n}\n\n@media (max-width: 900px) {\n  .tb-config-grid { grid-template-columns: 1fr; }\n  .tb-config-head { align-items: flex-start; flex-direction: column; }\n  body:has(.tb-panel) #toolbar .md-toolbar-tools h1::before {\n    content: \"\";\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n}\n</style>",
        "storeOutMessages": false,
