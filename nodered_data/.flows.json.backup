    {
        "id": "30582143ead073d2",
        "type": "function",
        "z": "bd221f64448ef576",
        "name": "tb_set_sensor_filter",
        "func": "flow.set('tb_sensor_filter', Array.isArray(msg.payload) ? msg.payload : []);\nreturn { topic: 'refresh', payload: {} };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
