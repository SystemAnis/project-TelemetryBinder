    {
        "id": "c7d0ebed2218db69",
        "type": "function",
        "z": "38cea33a51cf4774",
        "name": "Formatta Frase Dashboard",
        "func": "let nome = msg.payload.nome;\nlet cognome = msg.payload.cognome;\nlet eta = msg.payload.eta;\n\n// Genero il booleano calcolandolo dinamicamente dall'età\nlet isMaggiorenne = (eta >= 18);\n\n// Valuto la condizione sul parametro booleano appena creato\nlet stato = isMaggiorenne ? \"maggiorenne\" : \"minorenne\";\n\nmsg.payload = `${nome} ${cognome} ha ${eta} anni ed è ${stato}`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 440,
        "wires": [
            [
                "37f5fa5f2dc05b8a"
            ]
        ]
    },
