    {
        "id": "a38cd087134693f3",
        "type": "function",
        "z": "2b4da9a6ed6673da",
        "name": "function 3",
        "func": "// Variabili che ci servono per generare valori casuali\nconst sensori = [\n    { id: 'sensore_server_1', temp: [18, 27], hum: [40, 60], ram: [20, 85] },\n    { id: 'sensore_server_2', temp: [18, 27], hum: [40, 60], ram: [15, 80] },\n    { id: 'sensore_edge_1',   temp: [5, 45], hum: [20, 80], ram: [30, 90] }\n];\n\nfunction casuale(min, max, decimali) {\n    return (Math.random() * (max - min) + min).toFixed(decimali);\n}\n\n// Creazione di un array di messaggi (uno per ogni metrica)\n// Node-RED invierà 9 chiamate HTTP distinte al backend Python in uno\nconst messaggi = [];\n\nsensori.forEach(function(s) {\n    let tempCasuale = casuale(s.temp[0], s.temp[1], 1);\n    let umiditaCasuale = casuale(s.hum[0], s.hum[1], 0);\n    let ramCasuale = casuale(s.ram[0], s.ram[1], 0);\n\n    messaggi.push({\n        payload: {\n            \"sensor_id\": s.id,\n            \"metric\": \"temperatura\",\n            \"value\": tempCasuale\n        }\n    });\n    messaggi.push({\n        payload: {\n            \"sensor_id\": s.id,\n            \"metric\": \"umidita\",\n            \"value\": umiditaCasuale\n        }\n    });\n    messaggi.push({\n        payload: {\n            \"sensor_id\": s.id,\n            \"metric\": \"utilizzo_ram\",\n            \"value\": ramCasuale\n        }\n    });\n});\n\nreturn [messaggi];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 160,
        "wires": [
            [
                "3abd41bbf13a49cf"
            ]
        ]
    },
