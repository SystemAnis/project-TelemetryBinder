        "z": "38cea33a51cf4774",
        "name": "function 5",
        "func": "let cognome = msg.payload.surname;\nlet nome = msg.payload.name;\nlet anni = msg.payload.age;\n\n// Verifico se è maggiorenne (restituisce true o false)\nlet maggiorenne = anni >= 18;\n\n// Conversione del valore booleano per dire se è \"Maggiorenne\" o \"Minorenne\"\nlet stato = maggiorenne ? \"maggiorenne\" : \"minorenne\";\n\nlet frase = nome + \" \" + cognome + \" \" + \"ha\" + \" \" + anni + \" \" + \"anni\" + \" \" + \"ed è:\" + stato\n\nmsg.payload = frase;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 180,
        "wires": [
            [
                "0d739bd7c245e2f5"
            ]
        ]
    },
